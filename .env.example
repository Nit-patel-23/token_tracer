# ─────────────────────────────────────────────────────────────
# Token Tracer — environment variables
# Copy to .env.local and fill in values:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# Postgres connection (Neon recommended)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# NEON_CONNECTION_STRING=   # optional alias for DATABASE_URL

# Session signing secret (REQUIRED in production)
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Bootstrap passwords for env-based admin / superadmin login
# Prefer creating DB users via the admin panel after first boot.
ADMIN_PASSWORD=
SUPERADMIN_PASSWORD=

# Public origin used in daemon install commands (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: set to "1" to allow legacy team_admin bearer tokens (disabled by default)
# ALLOW_LEGACY_ADMIN_TOKEN=0

# Optional TLS override for Postgres ("true" | "false")
# Neon defaults to relaxed verification; other providers verify by default.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Daemon install helpers (optional; usually passed as CLI flags)
# TEAM_API_URL=http://localhost:3000
# TEAM_API_KEY=av_live_...
